# --- Model ---
# Gemini is the primary model and the only one that can call tools.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
# minimal = zero thought tokens (fastest, and fine because the planner does the
# routing). low/medium/high spend output tokens and latency on internal reasoning.
GEMINI_THINKING=minimal
# Google's built-in grounding tool. ON THE FREE TIER THIS IS OFTEN QUOTA-BLOCKED
# PER PROJECT, and a request containing it fails wholesale (not just the search).
# Leave unset until you've confirmed it works for your key.
# GEMINI_GROUNDING=1

# Groq is the text-only fallback and runs claim extraction after the response.
# Note: Groq rotates its free catalogue. Check `GET /openai/v1/models` if this 404s.
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-20b

OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# --- Web search (verification) ---
# One of: exa | tavily. Both have free tiers; the other is used as a fallback.
WEB_SEARCH_PROVIDER=exa
WEB_SEARCH_API_KEY=
# TAVILY_API_KEY=          # optional second provider

DATABASE_URL=file:./data/minimi.db
